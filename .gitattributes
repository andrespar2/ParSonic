# Normaliza los finales de linea en el repositorio (LF) para todos los archivos
# de texto. Evita diferencias espurias entre Windows y Linux/CI.
* text=auto eol=lf

# Binarios que Git no debe tocar.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.jar  binary
*.jks  binary
*.keystore binary
*.apk  binary
*.aab  binary
*.pb   binary

# Kits de lenguaje / herramientas.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Marca los archivos de Gradle/Kotlin/XML como texto.
*.kt    text
*.kts   text
*.xml   text
*.toml  text
*.pro   text
*.md    text
