<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permisos de ParSonic. Deliberadamente NO se usa AccessibilityService,
      root ni APIs privadas. Cada permiso tiene alternativa menos intrusiva
      cuando existe.
    -->

    <!-- Servicio en primer plano para mantener vivos los listener de gestos. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:targetApi="34" />

    <!-- Notificacion persistente obligatoria del servicio (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Zonas de gesto sobre otras apps ("Dibujar sobre otras apps"). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Inicio automatico opcional tras reiniciar el dispositivo. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Visibilidad de paquetes: permite leer el nombre legible de las apps que
      publican una sesion multimedia (Spotify, YouTube Music, VLC...).
      Es una declaracion de consulta, no un permiso de acceso a datos.
    -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".ParSonicApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParSonic"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ParSonic.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          NotificationListenerService: unica via publica para leer las sesiones
          multimedia activas de otras apps mediante MediaSessionManager.
          No accede al contenido de las notificaciones: solo se usa como
          "llave" de acceso al MediaSessionManager y para observar cambios.
        -->
        <service
            android:name=".service.MediaNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Servicio de gestos. Se ejecuta solo cuando el usuario lo activa y
          (opcionalmente) solo mientras hay reproduccion activa.
          Tipo specialUse: no reproducimos audio nosotros, controlamos sesiones.
        -->
        <service
            android:name=".service.GestureService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Captura de gestos tactiles y de sensores para controlar la reproduccion multimedia de otras aplicaciones." />
        </service>

        <!-- Inicio automatico opcional. -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
